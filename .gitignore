# data & model artifacts - never commit these
data/*
!data/.gitkeep
outputs/*                       # everything here lives in Drive, not git
!outputs/.gitkeep

# results/ IS tracked - it is the small stuff that travels back from Colab
# (run logs + figures, a few hundred KB). Big files stay in Drive.
*.pt
*.pth
*.ckpt
*.zip
*.csv
!docs/*.csv

# kaggle credentials
kaggle.json
.env

# python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# os
.DS_Store
