# data & model artifacts - never commit these
data/*
!data/.gitkeep
outputs/*                       # everything here lives in Drive, not git
!outputs/.gitkeep
*.pt
*.pth
*.ckpt
*.zip
*.csv
!docs/*.csv

# kaggle credentials
kaggle.json
.env

# python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# os
.DS_Store

# ---------------------------------------------------------------------------
# results/artifacts/ IS tracked. Must come LAST - git uses last-match-wins, so
# these negations have to sit below the *.csv / *.npy ignores above.
#
# OOF predictions (~10KB/fold) and test probabilities (~45KB each) live here so
# ANY Colab account can reproduce every comparison and every blend without
# access to the Drive that trained them. Only 20MB checkpoints stay in Drive.
# ---------------------------------------------------------------------------
!results/artifacts/
!results/artifacts/*.npz
!results/artifacts/*.npy
!results/artifacts/*.csv
